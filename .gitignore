# Dependencies
node_modules/

# Wrangler / Cloudflare local state
.wrangler/
.dev.vars

# Assembled from site/ by tools/build-dist.js (and by wrangler's build on deploy)
dist/

# Logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db

# Local reverse-engineering research (neocities/prod blobs, comparison harnesses).
# The snapshot generator + its committed tally are re-included: predeploy runs the
# generator, and the tally is the diffable record of badge membership counts.
research/*
!research/gen-snapshot.mjs
!research/badge-tally.json
# The badge timeline is recovered from this repo's own history, and CLAUDE.md points at
# it as the check on BADGE_HISTORY, so it has to travel with the code.
!research/badge-history.mjs

# Exported conversation transcripts
/20??-??-??-*.txt
